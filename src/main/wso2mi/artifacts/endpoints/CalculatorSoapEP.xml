<?xml version="1.0" encoding="UTF-8"?>
<!-- Public SOAP 1.1 test service (DNE Online Calculator). Injected per environment via CALCULATOR_SOAP_URL. -->
<endpoint name="CalculatorSoapEP" xmlns="http://ws.apache.org/ns/synapse">
    <address uri="$SYSTEM:CALCULATOR_SOAP_URL" format="soap11">
        <timeout>
            <duration>10000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <initialDuration>0</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>0</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
    </address>
</endpoint>
