<?xml version="1.0" encoding="UTF-8"?>
<endpoint name="AccountDataServiceEP" xmlns="http://ws.apache.org/ns/synapse">
    <http method="get" uri-template="http://localhost:8290/services/AccountDataService/account/{uri.var.accountNumber}">
        <timeout>
            <duration>8000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <initialDuration>0</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>0</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
