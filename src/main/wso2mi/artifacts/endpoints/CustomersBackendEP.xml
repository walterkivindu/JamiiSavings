<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSONPlaceholder /users/{id}. The full URI template is injected per environment via the
  CUSTOMERS_BACKEND_URL env var (set in docker-compose, default jsonplaceholder).
-->
<endpoint name="CustomersBackendEP" xmlns="http://ws.apache.org/ns/synapse">
    <http method="get" uri-template="$SYSTEM:CUSTOMERS_BACKEND_URL">
        <timeout>
            <duration>5000</duration>
            <responseAction>fault</responseAction>
        </timeout>
        <suspendOnFailure>
            <initialDuration>0</initialDuration>
            <progressionFactor>1.0</progressionFactor>
            <maximumDuration>0</maximumDuration>
        </suspendOnFailure>
        <markForSuspension>
            <retriesBeforeSuspension>0</retriesBeforeSuspension>
        </markForSuspension>
    </http>
</endpoint>
